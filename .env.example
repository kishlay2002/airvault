# VaultMind Environment Configuration

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vaultmind
POSTGRES_USER=vaultmind
POSTGRES_PASSWORD=changeme

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=default

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Ingestion
CHUNK_SIZE=512
CHUNK_OVERLAP=64
WATCH_DIRECTORY=/data/inbox

# Query API
QUERY_API_HOST=0.0.0.0
QUERY_API_PORT=8000
DEFAULT_TOP_K=5

# Security
API_KEY_SALT=changeme-salt
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=changeme

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
